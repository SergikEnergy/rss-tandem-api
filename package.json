{
  "name": "rss-tandem-api",
  "version": "0.0.1",
  "description": "API for RSS Tandem final task - Time Engineer Traveling",
  "author": "RSS Tandem",
  "private": true,
  "license": "RS School",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "docker:start": "docker-compose up --build",
    "docker:stop": "docker-compose down",
    "start:docker": "concurrently \"npm run docker:start\" \"npm run start:dev\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "migration:generate": "npx ts-node -P ./tsconfig.migrations.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d ./src/modules/database/migrations-config.ts ./src/modules/database/migrations/migration",
    "migration:create": "npx ts-node -P ./tsconfig.migrations.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create -d ./src/modules/database/migrations-config.ts ./src/modules/database/migrations/migration",
    "migration:run": "npx ts-node -P ./tsconfig.migrations.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d ./src/modules/database/migrations-config.ts",
    "migration:revert": "npx ts-node -P ./tsconfig.migrations.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d ./src/modules/database/migrations-config.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "11.0.1",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.0.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.0.1",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/typeorm": "11.0.0",
    "bcrypt": "6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "concurrently": "9.2.1",
    "cross-env": "7.0.3",
    "dotenv": "16.4.7",
    "passport-jwt": "4.0.1",
    "passport-local": "^1.0.0",
    "pg": "8.18.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.28",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.18.0",
    "@nestjs/cli": "11.0.0",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "5.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.10.7",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.0.0",
    "@typescript-eslint/parser": "8.0.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "8.3.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "5.2.2",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "16.0.0",
    "husky": "9.1.7",
    "jest": "30.0.0",
    "lint-staged": "15.4.2",
    "prettier": "3.4.2",
    "prettier-eslint": "16.3.0",
    "prettier-eslint-cli": "8.0.1",
    "source-map-support": "0.5.21",
    "supertest": "7.0.0",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier-eslint --write"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": "=22.14.0",
    "npm": ">=10.9",
    "yarn": "please-use-npm"
  },
  "packageManager": "npm@10.9.2"
}
